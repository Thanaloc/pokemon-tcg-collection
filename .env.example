# --- Database (Supabase / any PostgreSQL) ---
# Pooled connection used by the app at runtime.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
# Direct connection used by `prisma migrate`.
DIRECT_URL=postgresql://user:password@host:5432/postgres

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=
# Only needed outside Vercel when running `next start`.
# AUTH_TRUST_HOST=true

# --- Vercel Cron ---
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# --- Rate limiting (Upstash Redis) ---
# Without them rate limiting is disabled (fine locally, not in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Transactional emails (Resend) ---
# Without RESEND_API_KEY: accounts are verified at signup and emails are only
# printed in the server logs. With it: email verification + password reset.
RESEND_API_KEY=
# Must use a domain verified in Resend.
EMAIL_FROM="Pokémon TCG Collection <no-reply@your-domain.com>"
# Base URL used in email links. Defaults to the Vercel production URL.
APP_URL=https://your-domain.com

# --- Optional ---
# TCGDEX_API_URL=https://api.tcgdex.net/v2/fr
